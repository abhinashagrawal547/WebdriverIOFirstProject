  "type": "commonjs",
  "devDependencies": {
    "@tvlabs/wdio-service": "^0.1.13",
    "@types/node": "^25.9.1",
    "@wdio/allure-reporter": "^9.27.1",
    "@wdio/cli": "^9.27.1",
    "@wdio/globals": "^9.27.1",
    "@wdio/local-runner": "^9.27.1",
    "@wdio/mocha-framework": "^9.27.1",
    "@wdio/selenium-standalone-service": "^8.14.0",
    "@wdio/spec-reporter": "^9.27.1",
    "allure-commandline": "^2.41.0",
    "expect-webdriverio": "^5.6.5",
    "wdio-wait-for": "^3.1.1"
  }
