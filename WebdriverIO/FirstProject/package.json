{
  "name": "firstproject",
  "version": "1.0.0",
  "description": "",
  "main": "index.js",
  "scripts": {
    "wdio": "wdio run ./wdio.conf.ts",
    "test": "npx wdio run wdio.conf.ts",
    "test:cart": "npx wdio run wdio.conf.ts --spec test/specs/verifyCartItems.ts",
    "allure:clean": "rmdir /s /q allure-results & mkdir allure-results",
    "allure:generate": "allure generate allure-results --clean -o allure-report",
    "allure:open": "allure open allure-report",
    "allure:report": "npm run allure:generate && npm run allure:open",
    "test:report": "npm run allure:clean && npm test && npm run allure:report"
  },
  "keywords": [],
  "author": "",
